# Nelke environment configuration (copy to ~/.nelke/.env or project .env)

# Active LLM provider profile (see config.toml profiles)
NELKE_DEFAULT_PROFILE=openai

# Secrets referenced by profiles via api_key_ref (e.g. OPENAI_API_KEY)
OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=

# Nelke home directory (defaults to ~/.nelke)
NELKE_NELKE_HOME=~/.nelke

# Limits
NELKE_MAX_AGENT_ITERATIONS=20
NELKE_MAX_CYCLE_STEPS=30
NELKE_MAX_REVIEW_ROUNDS=3
NELKE_CODE_TIMEOUT=120
NELKE_WEB_TIMEOUT=30
NELKE_RECALL_TOP_K=8
NELKE_INDEX_MAX_TOKENS=2000
