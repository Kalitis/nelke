# Nelke environment configuration (copy to ~/.nelke/.env or project .env)

# Active LLM provider profile (see config.toml profiles)
NELKE_DEFAULT_PROFILE=openai

# Secrets referenced by profiles via api_key_ref (e.g. OPENAI_API_KEY)
OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=

# Nelke home directory (defaults to ~/.nelke)
NELKE_NELKE_HOME=~/.nelke

# Limits
NELKE_MAX_AGENT_ITERATIONS=20
NELKE_MAX_CYCLE_STEPS=30
NELKE_MAX_REVIEW_ROUNDS=3
NELKE_CODE_TIMEOUT=120
NELKE_WEB_TIMEOUT=30
NELKE_RECALL_TOP_K=8
NELKE_INDEX_MAX_TOKENS=2000

# Frontends
# Web: nelke web (--host/--port override these)
NELKE_WEB_HOST=127.0.0.1
NELKE_WEB_PORT=8000
# Telegram bot: nelke bot (get a token from @BotFather)
NELKE_TELEGRAM_TOKEN=
# Proxy for the Telegram bot if api.telegram.org is blocked from your network.
# Use the local port of your VPN/proxy tool (Hiddify, v2ray, Clash, …), e.g.:
#   NELKE_TELEGRAM_PROXY=socks5h://127.0.0.1:12334
#   NELKE_TELEGRAM_PROXY=http://127.0.0.1:12334
# NELKE_TELEGRAM_PROXY=

